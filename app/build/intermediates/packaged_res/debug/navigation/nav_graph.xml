<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.nodocivico.app.ui.auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nodocivico.app.ui.auth.LoginFragment"
        android:label="@string/btn_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nodocivico.app.ui.auth.RegisterFragment"
        android:label="@string/btn_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.nodocivico.app.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_reportList"
            app:destination="@id/reportListFragment" />
        <action
            android:id="@+id/action_home_to_createReport"
            app:destination="@id/createReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportListFragment"
        android:name="com.nodocivico.app.ui.reports.ReportListFragment"
        android:label="@string/nav_reports"
        tools:layout="@layout/fragment_report_list">
        <action
            android:id="@+id/action_reportList_to_reportDetail"
            app:destination="@id/reportDetailFragment" />
        <action
            android:id="@+id/action_reportList_to_createReport"
            app:destination="@id/createReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportDetailFragment"
        android:name="com.nodocivico.app.ui.reports.ReportDetailFragment"
        android:label="@string/nav_detail"
        tools:layout="@layout/fragment_report_detail">
        <argument
            android:name="reportId"
            app:argType="long" />
        <action
            android:id="@+id/action_reportDetail_to_editReport"
            app:destination="@id/editReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/createReportFragment"
        android:name="com.nodocivico.app.ui.reports.CreateReportFragment"
        android:label="@string/nav_create"
        tools:layout="@layout/fragment_create_report" />

    <fragment
        android:id="@+id/editReportFragment"
        android:name="com.nodocivico.app.ui.reports.EditReportFragment"
        android:label="@string/nav_edit"
        tools:layout="@layout/fragment_edit_report">
        <argument
            android:name="reportId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/calendarRemindersFragment"
        android:name="com.nodocivico.app.ui.reports.CalendarRemindersFragment"
        android:label="@string/nav_calendar"
        tools:layout="@layout/fragment_calendar_reminders" />

    <fragment
        android:id="@+id/syncStatusFragment"
        android:name="com.nodocivico.app.ui.home.SyncStatusFragment"
        android:label="@string/nav_sync"
        tools:layout="@layout/fragment_sync_status" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.nodocivico.app.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.nodocivico.app.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/mapZoneFragment"
        android:name="com.nodocivico.app.ui.home.MapZoneFragment"
        android:label="@string/nav_map"
        tools:layout="@layout/fragment_map_zone" />

</navigation>